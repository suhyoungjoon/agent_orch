# ── 데이터베이스 ───────────────────────────────────────────────────────
# 로컬 개발: SQLite (기본값, 별도 설치 불필요)
DATABASE_URL=sqlite+aiosqlite:///./agentflow.db

# PostgreSQL — 아래 중 하나를 선택해 주석 해제
# Supabase:  postgresql+asyncpg://postgres.PROJ:PASS@aws-0-REGION.pooler.supabase.com:6543/postgres
# Neon:      postgresql+asyncpg://USER:PASS@ep-xxx.REGION.aws.neon.tech/neondb?ssl=require
# Render:    자동 주입 (render.yaml의 fromDatabase 참고)
# Railway:   자동 주입 ($DATABASE_URL 환경 변수)
# Docker:    postgresql+asyncpg://agentflow:agentflow@db:5432/agentflow

# ── AI API ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── 인증 ──────────────────────────────────────────────────────────────
# 프로덕션에서는 반드시 32자 이상 랜덤 문자열로 교체
# 생성: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-in-production-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_DAYS=7

# ── CORS ──────────────────────────────────────────────────────────────
# 쉼표로 여러 출처 구분
CORS_ORIGINS=http://localhost:3000,https://agent-orch.vercel.app

# ── 앱 환경 ───────────────────────────────────────────────────────────
APP_ENV=development
